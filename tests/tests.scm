(use-modules (lda audit) (srfi srfi-1) (srfi srfi-13) (ice-9 popen) (ice-9 rdelim) (ice-9 format))

(define passed 0)
(define failed 0)
(define (check ok what)
  (if ok (set! passed (+ passed 1))
      (begin (set! failed (+ failed 1)) (format #t "FAIL: ~a~%" what))))

(define (rules text kind) (map finding-rule (audit text "t" kind)))
(define (has? text kind rule) (and (member rule (rules text kind)) #t))
(define (sev-of text kind rule)
  (let ((f (find (lambda (x) (string=? (finding-rule x) rule)) (audit text "t" kind)))) (and f (finding-sev f))))

(define good-login "PASS_MAX_DAYS 90\nPASS_MIN_DAYS 1\nPASS_WARN_AGE 14\nENCRYPT_METHOD SHA512\nUMASK 027\nLOGIN_RETRIES 3\n")
(define good-pwq "minlen = 14\nminclass = 3\ndictcheck = 1\nusercheck = 1\nenforcing = 1\n")
(define (login-with line) (string-append good-login line "\n"))
(define (without text key)
  (string-join (filter (lambda (l) (not (string-prefix-ci? key l))) (string-split text #\newline)) "\n"))
(define (cli args) (status:exit-val (system (string-append "bin/login-defs-audit " args " >/dev/null 2>&1"))))
(define (cli-out args)
  (let* ((p (open-input-pipe (string-append "bin/login-defs-audit " args " 2>/dev/null")))
         (s (read-string p)))
    (close-pipe p)
    (if (eof-object? s) "" s)))

;; parser
(let* ((r (parse-settings "# c\nKEY value # tail\nother = 5\n\nbad\n")) (s (car r)) (n (cdr r)))
  (check (equal? (assoc "key" s) '("key" "value" 2)) "key value and line")
  (check (equal? (assoc "other" s) '("other" "5" 3)) "key = value")
  (check (= (length n) 1) "one note for a lone word"))
(check (equal? (car (assoc "a" (car (parse-settings "A 1\nA 2\n")))) "a") "keys are lower-cased")
(check (equal? (cadr (assoc "a" (car (parse-settings "A 1\nA 2\n")))) "2") "last assignment wins")
(check (equal? (cadr (assoc "a" (car (parse-settings "a=\"x y\"\n")))) "x y") "quotes removed")
(check (equal? (caddr (assoc "k" (car (parse-settings "\n\n\nk 1\n")))) 4) "line numbers")
(check (null? (car (parse-settings ""))) "empty input")
(check (equal? (cadr (assoc "k" (car (parse-settings "k 1\r\n")))) "1") "CRLF")
(check (null? (car (parse-settings "123bad value\n"))) "invalid key name goes to notes")

;; umask
(check (umask-ok? "027") "027 ok")
(check (umask-ok? "077") "077 ok")
(check (umask-ok? "037") "037 ok")
(check (umask-ok? "0027") "0027 ok")
(check (not (umask-ok? "022")) "022 not ok")
(check (not (umask-ok? "002")) "002 not ok")
(check (not (umask-ok? "000")) "000 not ok")
(check (not (umask-ok? "abc")) "garbage umask")
(check (not (umask-ok? "")) "empty umask")
(check (not (umask-ok? "099")) "non-octal digits")

;; clean files
(check (null? (rules good-login 'login)) "clean login.defs has no findings")
(check (null? (rules good-pwq 'pwq)) "clean pwquality.conf has no findings")

;; LGN001..006 (login.defs)
(check (has? (without good-login "PASS_MAX_DAYS") 'login "LGN001") "LGN001 missing")
(check (has? (login-with "PASS_MAX_DAYS 99999") 'login "LGN001") "LGN001 99999")
(check (has? (login-with "PASS_MAX_DAYS 366") 'login "LGN001") "LGN001 366")
(check (not (has? (login-with "PASS_MAX_DAYS 365") 'login "LGN001")) "LGN001 365 ok")
(check (has? (login-with "PASS_MAX_DAYS abc") 'login "LGN001") "LGN001 not a number")
(check (has? (login-with "PASS_MIN_DAYS 0") 'login "LGN002") "LGN002 zero")
(check (has? (without good-login "PASS_MIN_DAYS") 'login "LGN002") "LGN002 missing")
(check (has? (login-with "PASS_WARN_AGE 3") 'login "LGN003") "LGN003 short")
(check (not (has? (login-with "PASS_WARN_AGE 7") 'login "LGN003")) "LGN003 7 ok")
(check (equal? "high" (sev-of (login-with "ENCRYPT_METHOD MD5") 'login "LGN004")) "LGN004 MD5 is high")
(check (equal? "high" (sev-of (login-with "ENCRYPT_METHOD des") 'login "LGN004")) "LGN004 DES case-insensitive")
(check (equal? "low" (sev-of (login-with "ENCRYPT_METHOD SHA256") 'login "LGN004")) "LGN004 SHA256 is low")
(check (equal? "low" (sev-of (without good-login "ENCRYPT_METHOD") 'login "LGN004")) "LGN004 missing is low")
(check (not (has? (login-with "ENCRYPT_METHOD YESCRYPT") 'login "LGN004")) "LGN004 yescrypt ok")
(check (has? (login-with "UMASK 022") 'login "LGN005") "LGN005 022")
(check (equal? "medium" (sev-of (login-with "UMASK 002") 'login "LGN005")) "LGN005 is medium")
(check (equal? "low" (sev-of (without good-login "UMASK") 'login "LGN005")) "LGN005 missing is low")
(check (has? (login-with "LOGIN_RETRIES 10") 'login "LGN006") "LGN006 ten")
(check (not (has? (login-with "LOGIN_RETRIES 5") 'login "LGN006")) "LGN006 five ok")
(check (has? (without good-login "LOGIN_RETRIES") 'login "LGN006") "LGN006 missing")
(check (not (has? good-pwq 'pwq "LGN001")) "login rules do not run on pwquality files")

;; LGN007..010 (pwquality)
(check (has? "minclass = 3\n" 'pwq "LGN007") "LGN007 missing")
(check (has? "minlen = 8\nminclass = 3\n" 'pwq "LGN007") "LGN007 short")
(check (not (has? "minlen = 12\nminclass = 3\n" 'pwq "LGN007")) "LGN007 12 ok")
(check (has? "minlen = 14\n" 'pwq "LGN008") "LGN008 no complexity")
(check (has? "minlen = 14\nminclass = 2\n" 'pwq "LGN008") "LGN008 minclass 2")
(check (not (has? "minlen = 14\nminclass = 4\n" 'pwq "LGN008")) "LGN008 minclass 4")
(check (not (has? "minlen = 14\ndcredit = -1\n" 'pwq "LGN008")) "LGN008 negative credit")
(check (has? "minlen = 14\ndcredit = 1\n" 'pwq "LGN008") "LGN008 positive credit is not a requirement")
(check (has? (string-append good-pwq "dictcheck = 0\n") 'pwq "LGN009") "LGN009 dictcheck")
(check (has? (string-append good-pwq "usercheck = 0\n") 'pwq "LGN009") "LGN009 usercheck")
(check (has? (string-append good-pwq "enforcing = 0\n") 'pwq "LGN010") "LGN010")
(check (not (has? good-pwq 'pwq "LGN010")) "LGN010 enforcing 1")

;; LGN000, locations, sorting
(check (has? "garbage\n" 'login "LGN000") "LGN000")
(check (equal? (finding-where (find (lambda (f) (string=? (finding-rule f) "LGN005")) (audit "\n\nUMASK 022\n" "etc/login.defs" 'login)))
               "etc/login.defs:3") "where is label:line")
(check (equal? (map finding-where (sort-findings (list (make-finding "low" "B" "a:1" "") (make-finding "high" "A" "b:9" "")
                                                       (make-finding "high" "A" "b:10" "") (make-finding "high" "A" "a:2" ""))))
               '("a:2" "b:9" "b:10" "a:1")) "sort by severity, file, numeric line")

;; hostile input and fuzz
(define (safe? thunk) (catch #t (lambda () (thunk) #t) (lambda args (format #t "exception: ~s~%" (car args)) #f)))
(check (and (safe? (lambda () (audit (make-string 200000 #\a) "h" 'login)))
            (safe? (lambda () (audit (make-string 100000 #\=) "h" 'pwq)))
            (safe? (lambda () (audit (string-append "umask " (make-string 5000 #\7)) "h" 'login)))
            (safe? (lambda () (audit "PASS_MAX_DAYS 999999999999999999999999\n" "h" 'login)))
            (safe? (lambda () (audit "minlen = -\nminclass = +\ndcredit = 1e5\n" "h" 'pwq)))
            (safe? (lambda () (audit "\x00\x00 = \x00\n" "h" 'login))))
       "hostile inputs do not raise")
(let ((seed "PASS_MAX_DAYS 90\nUMASK 027\nENCRYPT_METHOD MD5\nminlen = 14\ndcredit = -1\n# c\nk=v\n")
      (alphabet "= \n#\"-0123456789ABCabc")
      (state (seed->random-state 42))
      (ok #t))
  (do ((i 0 (+ i 1))) ((or (= i 3000) (not ok)))
    (let loop ((s seed) (k (+ 1 (random 6 state))))
      (if (> k 0)
          (let* ((s (if (string-null? s) "x" s))
                 (pos (random (string-length s) state))
                 (ch (string-ref alphabet (random (string-length alphabet) state))))
            (loop (case (random 3 state)
                    ((0) (string-append (substring s 0 pos) (string ch) (substring s (+ pos 1))))
                    ((1) (string-append (substring s 0 pos) (substring s (min (string-length s) (+ pos 1 (random 8 state))))))
                    (else (string-append (substring s 0 pos) (string ch) (substring s pos))))
                  (- k 1)))
          (unless (and (safe? (lambda () (audit s "f" 'login))) (safe? (lambda () (audit s "f" 'pwq))))
            (set! ok #f)))))
  (check ok "fuzzing 3000 inputs never raises"))

;; CLI
(check (= (cli "examples") 0) "cli exit 0")
(check (= (cli "examples --fail-on high") 1) "cli --fail-on high")
(check (= (cli "examples/hardened --fail-on medium") 0) "hardened directory passes")
(let* ((out (cli-out "examples --tsv")) (lines (filter (lambda (l) (not (string-null? l))) (string-split out #\newline))))
  (check (and (pair? lines) (string-prefix? "# " (car lines))
              (every (lambda (l) (= 3 (length (filter (lambda (c) (char=? c #\tab)) (string->list l))))) (cdr lines)))
         "tsv format"))
(check (= (cli "/no/such/path") 2) "missing path")
(check (= (cli "") 2) "no args")
(check (= (cli "examples --bogus") 2) "unknown flag")
(check (= (cli "examples --fail-on nope") 2) "bad --fail-on")
(check (= (cli "examples examples") 2) "two paths")

(format #t "~a passed, ~a failed~%" passed failed)
(exit (if (> failed 0) 1 0))
