(define-module (lda audit)
  #:use-module (srfi srfi-1)
  #:use-module (srfi srfi-13)
  #:export (rank-of parse-settings audit sort-findings umask-ok? finding-sev finding-rule finding-where finding-msg
            make-finding))

(define (rank-of sev)
  (cond ((string=? sev "critical") 0) ((string=? sev "high") 1) ((string=? sev "medium") 2)
        ((string=? sev "low") 3) (else 4)))

(define (make-finding sev rule where msg) (list sev rule where msg))
(define finding-sev car)
(define finding-rule cadr)
(define finding-where caddr)
(define finding-msg cadddr)

(define (split-lines text)
  (let loop ((chars (string->list text)) (cur '()) (acc '()))
    (cond ((null? chars) (reverse (cons (list->string (reverse cur)) acc)))
          ((char=? (car chars) #\newline) (loop (cdr chars) '() (cons (list->string (reverse cur)) acc)))
          ((char=? (car chars) #\return) (loop (cdr chars) cur acc))
          (else (loop (cdr chars) (cons (car chars) cur) acc)))))

;; Key names are lower-case letters, digits and underscores, not starting with a digit.
(define (valid-key? key)
  (and (> (string-length key) 0)
       (let ((c (string-ref key 0))) (or (char-alphabetic? c) (char=? c #\_)))
       (string-every (lambda (c) (or (char-alphabetic? c) (char-numeric? c) (char=? c #\_))) key)))

;; Returns (settings . notes). settings: alist of (key value line) with the LAST assignment first.
;; notes: list of (line . text).
(define (parse-settings text)
  (let loop ((lines (split-lines text)) (n 1) (settings '()) (notes '()))
    (if (null? lines)
        (cons settings (reverse notes))
        (let* ((raw (string-trim-both (car lines)))
               (line (let ((h (string-index raw #\#))) (if h (string-trim-both (substring raw 0 h)) raw))))
          (cond
           ((string-null? line) (loop (cdr lines) (+ n 1) settings notes))
           (else
            (let* ((eq (string-index line #\=))
                   (ws (string-index line (lambda (c) (or (char=? c #\space) (char=? c #\tab)))))
                   (cut (cond ((and eq ws) (min eq ws)) (eq eq) (ws ws) (else #f))))
              (if (not cut)
                  (loop (cdr lines) (+ n 1) settings (cons (cons n (string-take line (min 40 (string-length line)))) notes))
                  (let* ((key (string-downcase (string-trim-both (substring line 0 cut))))
                         (rest (string-trim-both (substring line cut)))
                         (rest (if (and (> (string-length rest) 0) (char=? (string-ref rest 0) #\=))
                                   (string-trim-both (substring rest 1))
                                   rest))
                         (rest (string-trim-both (string-trim-both rest #\") ))
                         (valid (valid-key? key)))
                    (if valid
                        (loop (cdr lines) (+ n 1) (cons (list key rest n) settings) notes)
                        (loop (cdr lines) (+ n 1) settings (cons (cons n (string-take line (min 40 (string-length line)))) notes))))))))))))

(define (setting settings key) (assoc key settings))
(define (value s) (cadr s))
(define (line-of s) (caddr s))

(define (to-number str)
  (and (string? str) (> (string-length str) 0) (<= (string-length str) 9)
       (string-every char-numeric? str) (string->number str)))

(define (octal str)
  (and (string? str) (> (string-length str) 0) (<= (string-length str) 5)
       (string-every (lambda (c) (and (char>=? c #\0) (char<=? c #\7))) str)
       (string->number str 8)))

;; A umask is acceptable when it removes group write and every permission for others (027 or stricter).
(define (umask-ok? str)
  (let ((v (octal str)))
    (and v (= (logand v #o027) #o027))))

(define (audit text label kind)
  (let* ((parsed (parse-settings text))
         (settings (car parsed))
         (notes (cdr parsed))
         (out '())
         (add! (lambda (sev rule line msg)
                 (set! out (cons (make-finding sev rule (string-append label ":" (number->string line)) msg) out)))))
    (for-each (lambda (n) (add! "info" "LGN000" (car n) (string-append "not a setting, ignored: " (cdr n)))) (reverse notes))
    (cond
     ((eq? kind 'login)
      (let ((max (setting settings "pass_max_days")) (min (setting settings "pass_min_days"))
            (warn (setting settings "pass_warn_age")) (enc (setting settings "encrypt_method"))
            (um (setting settings "umask")) (retries (setting settings "login_retries")))
        (cond ((not max) (add! "medium" "LGN001" 1 "PASS_MAX_DAYS is not set: passwords never expire"))
              ((let ((v (to-number (value max)))) (or (not v) (> v 365)))
               (add! "medium" "LGN001" (line-of max) (string-append "PASS_MAX_DAYS is " (value max) ": passwords live longer than a year"))))
        (cond ((not min) (add! "low" "LGN002" 1 "PASS_MIN_DAYS is not set: a user can change a password straight back"))
              ((eqv? (to-number (value min)) 0) (add! "low" "LGN002" (line-of min) "PASS_MIN_DAYS is 0: a user can change a password straight back")))
        (cond ((not warn) (add! "low" "LGN003" 1 "PASS_WARN_AGE is not set"))
              ((let ((v (to-number (value warn)))) (or (not v) (< v 7)))
               (add! "low" "LGN003" (line-of warn) (string-append "PASS_WARN_AGE is " (value warn) ": users get under a week of notice"))))
        (cond ((not enc) (add! "low" "LGN004" 1 "ENCRYPT_METHOD is not set: check that new passwords use SHA512 or yescrypt"))
              ((member (string-upcase (value enc)) '("MD5" "DES"))
               (add! "high" "LGN004" (line-of enc) (string-append "ENCRYPT_METHOD " (value enc) ": new password hashes are weak")))
              ((string=? (string-upcase (value enc)) "SHA256")
               (add! "low" "LGN004" (line-of enc) "ENCRYPT_METHOD SHA256: prefer SHA512 or yescrypt")))
        (cond ((not um) (add! "low" "LGN005" 1 "UMASK is not set"))
              ((not (umask-ok? (value um)))
               (add! "medium" "LGN005" (line-of um) (string-append "UMASK " (value um) " leaves new files readable by other users: use 027 or stricter"))))
        (cond ((not retries) (add! "low" "LGN006" 1 "LOGIN_RETRIES is not set (the default is 10)"))
              ((let ((v (to-number (value retries)))) (or (not v) (> v 5)))
               (add! "low" "LGN006" (line-of retries) (string-append "LOGIN_RETRIES is " (value retries) ": allow 5 at most"))))))
     (else
      (let ((minlen (setting settings "minlen")) (minclass (setting settings "minclass"))
            (dictcheck (setting settings "dictcheck")) (usercheck (setting settings "usercheck"))
            (enforcing (setting settings "enforcing")))
        (cond ((not minlen) (add! "medium" "LGN007" 1 "minlen is not set: the default is 8 characters"))
              ((let ((v (to-number (value minlen)))) (or (not v) (< v 12)))
               (add! "medium" "LGN007" (line-of minlen) (string-append "minlen is " (value minlen) ": use at least 12"))))
        (let* ((credit-neg? (lambda (k) (let ((s (setting settings k)))
                                          (and s (let ((v (string->number (value s)))) (and v (< v 0)))))))
               (class-ok? (and minclass (let ((v (to-number (value minclass)))) (and v (>= v 3))))))
          (unless (or class-ok? (any credit-neg? '("dcredit" "ucredit" "lcredit" "ocredit")))
            (add! "medium" "LGN008" (if minclass (line-of minclass) 1)
                  "no complexity rule: set minclass to 3 or more, or negative dcredit, ucredit, lcredit and ocredit")))
        (when (and dictcheck (eqv? (to-number (value dictcheck)) 0))
          (add! "medium" "LGN009" (line-of dictcheck) "dictcheck = 0: dictionary words are accepted"))
        (when (and usercheck (eqv? (to-number (value usercheck)) 0))
          (add! "medium" "LGN009" (line-of usercheck) "usercheck = 0: passwords containing the user name are accepted"))
        (when (and enforcing (eqv? (to-number (value enforcing)) 0))
          (add! "medium" "LGN010" (line-of enforcing) "enforcing = 0: weak passwords only produce a warning")))))
    (reverse out)))

(define (split-where w)
  (let ((i (string-rindex w #\:)))
    (cons (substring w 0 i) (or (string->number (substring w (+ i 1))) 0))))

(define (sort-findings fs)
  (stable-sort fs
               (lambda (a b)
                 (let ((ra (rank-of (finding-sev a))) (rb (rank-of (finding-sev b)))
                       (wa (split-where (finding-where a))) (wb (split-where (finding-where b))))
                   (cond ((not (= ra rb)) (< ra rb))
                         ((not (string=? (car wa) (car wb))) (string<? (car wa) (car wb)))
                         ((not (= (cdr wa) (cdr wb))) (< (cdr wa) (cdr wb)))
                         (else (string<? (finding-rule a) (finding-rule b))))))))
