(use-modules (lda audit) (srfi srfi-1) (srfi srfi-13) (ice-9 ftw) (ice-9 rdelim) (ice-9 format))

(define (usage)
  (format (current-error-port) "usage: login-defs-audit PATH [--tsv] [--fail-on medium|high|critical]~%Exit: 0 ok, 1 findings at or above --fail-on, 2 bad input.~%")
  2)

(define (file-kind path)
  (let* ((name (basename path))
         (parent (basename (dirname path))))
    (cond ((string=? name "login.defs") 'login)
          ((string=? name "pwquality.conf") 'pwq)
          ((and (string=? parent "pwquality.conf.d") (string-suffix? ".conf" name)) 'pwq)
          (else #f))))

(define (read-file path)
  (call-with-input-file path
    (lambda (p) (let ((s (read-string p 4000000))) (if (eof-object? s) "" s)))
    #:encoding "ISO-8859-1"))

(define (walk dir)
  (let ((entries (or (scandir dir (lambda (n) (not (member n '("." ".."))))) '())))
    (append-map (lambda (n)
                  (let ((full (string-append dir "/" n)))
                    (if (and (file-exists? full) (eq? (stat:type (stat full)) 'directory))
                        (walk full)
                        (list full))))
                entries)))

(define (run args)
  (let loop ((rest args) (path #f) (tsv #f) (fail #f))
    (cond
     ((null? rest)
      (cond
       ((not path) (usage))
       ((not (file-exists? path))
        (format (current-error-port) "error: no such file or directory: ~a~%" path)
        2)
       (else (report path tsv fail))))
     ((string=? (car rest) "--tsv") (loop (cdr rest) path #t fail))
     ((string=? (car rest) "--fail-on")
      (if (and (pair? (cdr rest)) (member (cadr rest) '("medium" "high" "critical")))
          (loop (cddr rest) path tsv (cadr rest))
          (usage)))
     ((and (> (string-length (car rest)) 0) (char=? (string-ref (car rest) 0) #\-)) (usage))
     (path (usage))
     (else (loop (cdr rest) (car rest) tsv fail)))))

(define (report path tsv fail)
  (let* ((dir? (eq? (stat:type (stat path)) 'directory))
         (base (string-trim-right path #\/))
         (files (if dir?
                    (sort (filter (lambda (f) (file-kind f)) (walk base)) string<?)
                    (list path)))
         (label (lambda (f) (if dir? (substring f (+ (string-length base) 1)) (basename f))))
         (all (append-map (lambda (f)
                            (let ((kind (or (file-kind f) (if (string-contains (basename f) "pwquality") 'pwq 'login))))
                              (if (> (stat:size (stat f)) 4000000) '()
                                  (audit (read-file f) (label f) kind))))
                          files))
         (sorted (sort-findings all))
         (head (format #f "~a files, ~a findings" (length files) (length sorted))))
    (display (if tsv (string-append "# " head) head)) (newline)
    (for-each
     (lambda (f)
       (if tsv
           (begin (display (string-join (list (finding-sev f) (finding-rule f) (finding-where f) (finding-msg f)) "\t")) (newline))
           (begin (format #t "~8a ~a ~a~%" (string-upcase (finding-sev f)) (finding-rule f) (finding-where f))
                  (format #t "         ~a~%" (finding-msg f)))))
     sorted)
    (if (and fail (any (lambda (f) (<= (rank-of (finding-sev f)) (rank-of fail))) sorted)) 1 0)))

(let ((code (run (cdr (command-line)))))
  (force-output)
  (exit code))
